GOOGLE_CLOUD_PROJECT=course-transcript-mvp
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET=course-transcript-mvp
VERTEX_MODEL=gemini-3.7-flash
SPEECH_LOCATION=us
INFRA_TEST_PREFIX=test
PHASE2_SAMPLE_SECONDS=300
PHASE2_MODEL=gemini-3.7-flash

# Web/batch orchestration. These values contain no credentials.
COURSE_TRANSCRIPT_DATA_DIR=/app/data
COURSE_TRANSCRIPT_ALLOWED_SOURCE_PREFIX=gdrive:
COURSE_TRANSCRIPT_BATCH_MAX_FILES=100
COURSE_TRANSCRIPT_DRIVE_BROWSE_MAX_ENTRIES=500
COURSE_TRANSCRIPT_DRIVE_BROWSE_CACHE_SECONDS=60
COURSE_TRANSCRIPT_DRIVE_BROWSER_PROVIDER=google_api
COURSE_TRANSCRIPT_DRIVE_BROWSER_FALLBACK=true
COURSE_TRANSCRIPT_DRIVE_REMOTE=gdrive
GOOGLE_DRIVE_PAGE_SIZE=200
# Optional root folder restriction. Leave empty for My Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Preferred: mount a JSON/plain-text refresh token file. The API keeps refreshed
# access tokens in memory and never rewrites the mounted secret.
GOOGLE_DRIVE_REFRESH_TOKEN_FILE=/run/secrets/google-drive-refresh-token
# OAuth client values may be injected through a protected environment file or
# secret manager. When omitted, the provider reads client_id/client_secret/token
# from the configured [gdrive] section of rclone.conf.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional for large recursive folder previews. Test memory and latency before enabling.
COURSE_TRANSCRIPT_RCLONE_FAST_LIST=false
COURSE_TRANSCRIPT_COST_LIMIT_USD=200
COURSE_TRANSCRIPT_COST_WARNING_THRESHOLDS_USD=50,100,160,190
# User-facing application estimate budget. The baseline freezes existing USD
# reservations so the current displayed balance starts at NT$1,200. The
# exchange rate is for application estimates only; Cloud Billing remains
# authoritative for actual charges.
COURSE_TRANSCRIPT_BUDGET_REMAINING_TWD=1200
COURSE_TRANSCRIPT_USD_TO_TWD=32
COURSE_TRANSCRIPT_BUDGET_BASELINE_COMMITTED_USD=132.6374
# Automatically use the latest Central Bank of the Republic of China daily
# NTD/USD closing rate for new TWD estimates. USD remains the accounting source
# of truth; the cached rate is stored under COURSE_TRANSCRIPT_DATA_DIR.
COURSE_TRANSCRIPT_FX_AUTO_ENABLED=true
COURSE_TRANSCRIPT_FX_URL=https://cpx.cbc.gov.tw/api/OpenData/FTDOpenData_Day
COURSE_TRANSCRIPT_FX_CACHE_TTL_SECONDS=86400
COURSE_TRANSCRIPT_FX_MAX_STALE_SECONDS=259200
COURSE_TRANSCRIPT_FX_TIMEOUT_SECONDS=5
COURSE_TRANSCRIPT_FX_CACHE_PATH=/app/data/fx/usd-twd.json
COURSE_TRANSCRIPT_MINIMUM_FREE_SPACE_GB=3
COURSE_TRANSCRIPT_REQUIRE_ACCESS_HEADERS=true
COURSE_TRANSCRIPT_PUBLIC_ORIGIN=https://transcript.randy88.ccwu.cc
RCLONE_CONFIG_HOST_PATH=/home/ubuntu/.config/rclone/rclone.conf
GOOGLE_DRIVE_REFRESH_TOKEN_HOST_PATH=/opt/course-transcript/secrets/google-drive-refresh-token

# Per-source concurrency. A serial 120-second Chirp canary must finish before
# the normal 15-minute chunks are submitted.
CHIRP_CANARY_DURATION_SECONDS=120
CHIRP_MAX_PARALLEL_CHUNKS=3
CHIRP_MAX_PARALLEL_CHUNKS_LIMIT=5
# GCS result recovery is bounded separately and never polls Speech LRO status.
CHIRP_MAX_PARALLEL_RECOVERY=3

# Text correction. Chirp 3 raw text and timestamps remain immutable.
# Gemini 3.7 Flash remains the production-safe provider until M3 runtime/quota
# behaviour and real transcript quality have been validated on the VPS.
CORRECTION_CASCADE_ENABLED=false
CORRECTION_DEFAULT_POLICY=GEMINI_FIRST
# The UI/API may persist M3_FIRST before runtime enablement, but the worker must
# continue using Gemini until MINIMAX_M3_ENABLED is explicitly turned on after
# smoke tests and A/B validation.
MINIMAX_M3_ENABLED=false
MINIMAX_M3_MODEL=MiniMax-M3
MINIMAX_M3_QUOTA_CHECK_ENABLED=false
MINIMAX_M3_RATE_LIMIT_MAX_ATTEMPTS=3
MINIMAX_M3_INVALID_RESPONSE_MAX_ATTEMPTS=2
# This account is provisioned on the CN MiniMax endpoint. Keep this explicit;
# do not silently fall back to the global endpoint, which returns invalid-key.
MINIMAX_M3_QUOTA_URL=https://api.minimaxi.com/v1/token_plan/remains
MINIMAX_M3_API_PATH=/v1/chat/completions
MINIMAX_M3_QUOTA_CACHE_SECONDS=30
MINIMAX_M3_QUOTA_TIMEOUT_SECONDS=15
MINIMAX_M3_TIMEOUT_SECONDS=60
MINIMAX_M3_MAX_OUTPUT_TOKENS=4096
# MiniMax-M3 officially supports disabled/adaptive thinking. Fixed-segment
# correction is deterministic, so disable thinking by default to avoid spending
# output budget and latency on unnecessary reasoning. Terminology extraction
# was already stable in Phase B/C, so preserve adaptive thinking there until a
# separate glossary-quality experiment justifies changing it.
MINIMAX_M3_CORRECTION_THINKING_MODE=disabled
MINIMAX_M3_TERMINOLOGY_THINKING_MODE=adaptive
# Live CN MiniMax-M3 capability testing confirmed this separates reasoning
# from final structured content; keep enabled when M3 is later validated.
MINIMAX_M3_REASONING_SPLIT=true
# Streaming 2.0 is code-ready but remains opt-in until the full per-course
# long-run reliability and quality gate passes. Production Compose deliberately
# does not pass these variables through yet.
MINIMAX_M3_STREAMING_ENABLED=false
MINIMAX_M3_STREAM_DEADLINE_SECONDS=75
# Runtime secrets/endpoints are intentionally not populated here. The deployment
# agent must validate the actual MiniMax Token Plan API before enabling M3.
MINIMAX_API_KEY_FILE=/run/secrets/minimax-api-key
MINIMAX_API_BASE_URL=https://api.minimaxi.com
# Existing cascade remains locked to Gemini until provider routing is wired in.
CORRECTION_PRIMARY_MODEL=gemini-3.7-flash
CORRECTION_ESCALATION_MODEL=gemini-3.7-flash
CORRECTION_MODEL_MAX_ATTEMPTS=3
CORRECTION_ESCALATE_UNCERTAIN=true
# Gemini correction windows share a global terminology pass before parallel work.
GEMINI_MAX_PARALLEL_WINDOWS=2
GEMINI_CORRECTION_WINDOW_MS=30000

# Dynamic Batch is an economical, non-interactive processing mode. These are
# local operational alert thresholds; they never trigger an automatic resubmit.
DYNAMIC_BATCH_WARNING_HOURS=18
DYNAMIC_BATCH_CRITICAL_HOURS=23
DYNAMIC_BATCH_SLA_HOURS=24

# Optional Cloud Billing standard export. Keep disabled until the dataset and
# a dedicated read-only billing service account are configured manually.
BILLING_ENABLED=false
BILLING_BIGQUERY_PROJECT=
BILLING_BIGQUERY_DATASET=
BILLING_BIGQUERY_TABLE=
BILLING_ACCOUNT_ID=
BILLING_TARGET_PROJECT_ID=course-transcript-mvp
BILLING_TRACKING_START_DATE=2026-07-01
BILLING_INITIAL_FREE_TRIAL_CREDIT_USD=300
BILLING_PROMOTION_NAME_PATTERN=Free trial
BILLING_SYNC_INTERVAL_SECONDS=900
BILLING_SNAPSHOT_STALE_SECONDS=3600
BILLING_MAXIMUM_BYTES_BILLED=1000000000
BILLING_CREDENTIALS_HOST_PATH=/opt/course-transcript/secrets/billing-sa.json
BILLING_GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/billing-sa.json
