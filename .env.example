GOOGLE_CLOUD_PROJECT=course-transcript-mvp
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET=course-transcript-mvp
VERTEX_MODEL=gemini-3.7-flash
SPEECH_LOCATION=us
INFRA_TEST_PREFIX=test
PHASE2_SAMPLE_SECONDS=300
PHASE2_MODEL=gemini-3.6-flash

# Web/batch orchestration. These values contain no credentials.
COURSE_TRANSCRIPT_DATA_DIR=/app/data
COURSE_TRANSCRIPT_ALLOWED_SOURCE_PREFIX=gdrive:
COURSE_TRANSCRIPT_BATCH_MAX_FILES=100
COURSE_TRANSCRIPT_DRIVE_BROWSE_MAX_ENTRIES=500
COURSE_TRANSCRIPT_DRIVE_BROWSE_CACHE_SECONDS=60
COURSE_TRANSCRIPT_DRIVE_BROWSER_PROVIDER=google_api
COURSE_TRANSCRIPT_DRIVE_BROWSER_FALLBACK=true
COURSE_TRANSCRIPT_DRIVE_REMOTE=gdrive
GOOGLE_DRIVE_PAGE_SIZE=200
# Optional root folder restriction. Leave empty for My Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Preferred: mount a JSON/plain-text refresh token file. The API keeps refreshed
# access tokens in memory and never rewrites the mounted secret.
GOOGLE_DRIVE_REFRESH_TOKEN_FILE=/run/secrets/google-drive-refresh-token
# OAuth client values may be injected through a protected environment file or
# secret manager. When omitted, the provider reads client_id/client_secret/token
# from the configured [gdrive] section of rclone.conf.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional for large recursive folder previews. Test memory and latency before enabling.
COURSE_TRANSCRIPT_RCLONE_FAST_LIST=false
COURSE_TRANSCRIPT_COST_LIMIT_USD=200
COURSE_TRANSCRIPT_COST_WARNING_THRESHOLDS_USD=50,100,160,190
COURSE_TRANSCRIPT_MINIMUM_FREE_SPACE_GB=3
COURSE_TRANSCRIPT_REQUIRE_ACCESS_HEADERS=true
COURSE_TRANSCRIPT_PUBLIC_ORIGIN=https://transcript.randy88.ccwu.cc
RCLONE_CONFIG_HOST_PATH=/home/ubuntu/.config/rclone/rclone.conf
GOOGLE_DRIVE_REFRESH_TOKEN_HOST_PATH=/opt/course-transcript/secrets/google-drive-refresh-token

# Per-source concurrency. A serial 120-second Chirp canary must finish before
# the normal 15-minute chunks are submitted.
CHIRP_CANARY_DURATION_SECONDS=120
CHIRP_MAX_PARALLEL_CHUNKS=3
CHIRP_MAX_PARALLEL_CHUNKS_LIMIT=5
# GCS result recovery is bounded separately and never polls Speech LRO status.
CHIRP_MAX_PARALLEL_RECOVERY=3

# Text correction cascade. Chirp 3 raw text and timestamps remain immutable.
# Keep disabled until a small paid A/B test validates quality, model availability,
# escalation rate, token usage, and total cost in the target Vertex AI project.
CORRECTION_CASCADE_ENABLED=false
# The economical model handles normal segments; only risky segments escalate.
# Any invalid or unsafe result falls back to the original Chirp text.
CORRECTION_PRIMARY_MODEL=gemini-3.1-flash-lite
CORRECTION_ESCALATION_MODEL=gemini-3.7-flash
CORRECTION_MODEL_MAX_ATTEMPTS=3
CORRECTION_ESCALATE_UNCERTAIN=true
# Gemini correction windows share a global terminology pass before parallel work.
GEMINI_MAX_PARALLEL_WINDOWS=2
GEMINI_CORRECTION_WINDOW_MS=30000

# Dynamic Batch is an economical, non-interactive processing mode. These are
# local operational alert thresholds; they never trigger an automatic resubmit.
DYNAMIC_BATCH_WARNING_HOURS=18
DYNAMIC_BATCH_CRITICAL_HOURS=23
DYNAMIC_BATCH_SLA_HOURS=24

# Optional Cloud Billing standard export. Keep disabled until the dataset and
# a dedicated read-only billing service account are configured manually.
BILLING_ENABLED=false
BILLING_BIGQUERY_PROJECT=
BILLING_BIGQUERY_DATASET=
BILLING_BIGQUERY_TABLE=
BILLING_ACCOUNT_ID=
BILLING_TARGET_PROJECT_ID=course-transcript-mvp
BILLING_TRACKING_START_DATE=2026-07-01
BILLING_INITIAL_FREE_TRIAL_CREDIT_USD=300
BILLING_PROMOTION_NAME_PATTERN=Free trial
BILLING_SYNC_INTERVAL_SECONDS=900
BILLING_SNAPSHOT_STALE_SECONDS=3600
BILLING_MAXIMUM_BYTES_BILLED=1000000000
BILLING_CREDENTIALS_HOST_PATH=/opt/course-transcript/secrets/billing-sa.json
BILLING_GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/billing-sa.json
